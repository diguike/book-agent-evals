{
  "name": "@inferloop/shopagent",
  "version": "0.1.0",
  "private": true,
  "description": "ShopAgent —— 全书贯穿的被评测样本（主线 8 工具 + 5 policy 版）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo data",
    "dev": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
