# 复制为 .env 后填入真实 key。.env 已在 .gitignore，不会进 git。

# —— LLM Provider Keys ——
# 第 2 章起所有评测都需要。默认指向 OpenAI 官方。
OPENAI_API_KEY=

# 如果用 OpenAI 兼容协议接其他模型，覆盖 base url
# 比如 DeepSeek: https://api.deepseek.com/v1
# 比如阿里通义: https://dashscope.aliyuncs.com/compatible-mode/v1
# 比如智谱: https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=

# Anthropic 直连（第 6 章 provider 抽象会用到）
ANTHROPIC_API_KEY=

# —— 评测运行配置 ——
# 评测时默认模型；CLI / 章节 example 都支持环境变量覆盖
MODEL=gpt-4o

# 全局并发上限（第 6 章 provider 池会用到）
EVALKIT_CONCURRENCY=4

# 日志输出目录
EVALKIT_RUNS_DIR=runs
